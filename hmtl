    <!-- JAVASCRIPT LOGIC -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            
            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            const mobileLinks = document.querySelectorAll('.mobile-link');

            if (mobileMenuBtn && mobileMenu) {
                mobileMenuBtn.addEventListener('click', function () {
                    mobileMenu.classList.toggle('hidden');
                });

                mobileLinks.forEach(link => {
                    link.addEventListener('click', () => {
                        mobileMenu.classList.add('hidden');
                    });
                });
            }

            let selectedArea = 'Face e Pescoço (Facial)';
            let selectedGoals = [];

            const areaBtns = document.querySelectorAll('.sim-btn-area');
            const goalBtns = document.querySelectorAll('.sim-btn-goal');
            const patientNameInput = document.getElementById('sim-patient-name');
            const summaryText = document.getElementById('sim-summary-text');
            const whatsappBtn = document.getElementById('sim-whatsapp-btn');

            function updateSimulatorSummary() {
                const patientName = patientNameInput ? patientNameInput.value.trim() : '';
                let namePrefix = patientName ? `Paciente: **${patientName}**` : `Paciente: Não informado`;
                let text = `${namePrefix} | Área Selecionada: **${selectedArea}**`;
                
                if (selectedGoals.length > 0) {
                    text += ` | Procedimentos: ${selectedGoals.join(', ')}`;
                } else {
                    text += ` | Escolha um ou mais procedimentos acima.`;
                }

                summaryText.innerHTML = text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');

                const rawMessage = `Ol%C3%A1%20Dra.%20Camilla%20Bri%C3%A3o%21%20Simulei%20meu%20plano%20no%20site%20da%20PuraPelle%20Clinic%3A%0A-%20Nome%3A%20${encodeURIComponent(patientName || 'Cliente')}%0A-%20%C3%81rea%3A%20${encodeURIComponent(selectedArea)}%0A-%20Procedimentos%3A%20${encodeURIComponent(selectedGoals.join(', ') || 'Geral')}`;
                whatsappBtn.href = `https://wa.me/5500000000000?text=${rawMessage}`;
            }

            if (patientNameInput) {
                patientNameInput.addEventListener('input', updateSimulatorSummary);
            }

            areaBtns.forEach(btn => {
                btn.addEventListener('click', function () {
                    areaBtns.forEach(b => {
                        b.classList.remove('border-gold-500', 'bg-gold-50');
                        b.classList.add('border-gray-200');
                    });
                    this.classList.remove('border-gray-200');
                    this.classList.add('border-gold-500', 'bg-gold-50');

                    selectedArea = this.getAttribute('data-area');
                    updateSimulatorSummary();
                });
            });

            if (areaBtns.length > 0) {
                areaBtns[0].click();
            }

            goalBtns.forEach(btn => {
                btn.addEventListener('click', function () {
                    const goal = this.getAttribute('data-goal');
                    const icon = this.querySelector('i');

                    if (selectedGoals.includes(goal)) {
                        selectedGoals = selectedGoals.filter(g => g !== goal);
                        this.classList.remove('border-gold-500', 'bg-gold-50', 'text-gold-800');
                        this.classList.add('border-gray-200');
                        if (icon) icon.classList.add('opacity-0');
                    } else {
                        selectedGoals.push(goal);
                        this.classList.remove('border-gray-200');
                        this.classList.add('border-gold-500', 'bg-gold-50', 'text-gold-800');
                        if (icon) icon.classList.remove('opacity-0');
                    }

                    updateSimulatorSummary();
                });
            });

            const contactForm = document.getElementById('contact-form');
            const formSuccess = document.getElementById('form-success');

            if (contactForm) {
                contactForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    
                    const name = document.getElementById('form-name').value;
                    const phone = document.getElementById('form-phone').value;
                    const treatment = document.getElementById('form-treatment').value;
                    const shift = document.getElementById('form-shift').value;
                    const message = document.getElementById('form-message').value;

                    const msgText = `Ol%C3%A1%20Dra.%20Camilla%20Bri%C3%A3o%21%20Solicito%20agendamento%20na%20PuraPelle%20Clinic.%0A-%20Nome%3A%20${encodeURIComponent(name)}%0A-%20Telefone%3A%20${encodeURIComponent(phone)}%0A-%20Tratamento%3A%20${encodeURIComponent(treatment)}%0A-%20Turno%3A%20${encodeURIComponent(shift)}%0A-%20Mensagem%3A%20${encodeURIComponent(message)}`;

                    if (formSuccess) {
                        formSuccess.classList.remove('hidden');
                    }

                    setTimeout(() => {
                        window.open(`https://wa.me/5500000000000?text=${msgText}`, '_blank');
                    }, 800);
                });
            }

        });
    </script>
